<Window x:Class="WowWallPaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WowWallPaper"
        Width="1280" Height="840" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/app.ico"
        AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,13" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#4A2733" />
        </Style>
        <DataTemplate x:Key="FitOptionTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="RotationOptionTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderBrush="#1C2940" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid Grid.Row="0" Background="#080D16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="29" Height="29" CornerRadius="9" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="W" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold"
                                   Foreground="#06111B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="WowWallPaper" FontFamily="{StaticResource DisplayFont}" FontSize="14.5"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Background="#12233A" CornerRadius="5" Padding="6,2" Margin="9,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="ENGINE" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE921;" ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE922;" ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButtonStyle}"
                            Content="&#xE8BB;" ToolTip="关闭" Click="CloseButton_Click" />
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="#121C2C" Grid.ColumnSpan="2" />
            </Grid>

            <!-- ================= Main shell ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#152033"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="14,20,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="浏览" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                                   Margin="10,0,0,8" />

                        <ListBox Grid.Row="1" Style="{StaticResource NavListBoxStyle}"
                                 ItemsSource="{Binding FilterOptions}"
                                 SelectedItem="{Binding SelectedFilterOption, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="43">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Indicator" Width="3" Height="17" CornerRadius="2"
                                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource IconGlyphStyle}"
                                                   FontSize="16"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <Border Grid.Column="3" Style="{StaticResource NavCountStyle}">
                                            <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                           Value="True" />
                                                <Condition Binding="{Binding DataContext.IsSettingsVisible, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                           Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock Text="工具" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,8" />
                            <Button Style="{StaticResource SettingsNavButtonStyle}" Command="{Binding ShowSettingsCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphStyle}" FontSize="16"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Grid.Column="1" Text="设置" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Height="43" HorizontalContentAlignment="Stretch"
                                    Padding="10,0" Margin="0,2,0,0" Command="{Binding OpenDataFolderCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyphStyle}" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="数据目录" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Rotation card -->
                        <Border Grid.Row="4" Background="#0A111D" BorderBrush="#172438" BorderThickness="1"
                                CornerRadius="14" Padding="13" Margin="0,14,0,10">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="自动轮播" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding RotationStatusText}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding AutoRotate, Mode=TwoWay}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ToolTip="自动轮播壁纸" />
                                </Grid>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="32" FontSize="11.5"
                                        Margin="0,12,0,0" Command="{Binding NextCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE893;" Style="{StaticResource IconGlyphStyle}" FontSize="12"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="下一张壁纸" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="5" Margin="0,4,0,0">
                            <TextBlock Text="{Binding VersionText}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                        Command="{Binding ExitCommand}" ToolTip="退出 WowWallPaper">
                                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyphStyle}" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Library header -->
                    <Grid Grid.Row="0" Margin="30,24,30,18"
                          Visibility="{Binding IsSettingsVisible, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="壁纸库" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding LibrarySummary}" FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="218" Height="37" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                                    CornerRadius="10" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" FontSize="13"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="搜索壁纸" FontSize="12.5"
                                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibility}}" />
                                    </Grid>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                            Click="ClearSearchButton_Click" ToolTip="清除搜索"
                                            Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" FontSize="10" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddFilesButton_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyphStyle}" FontSize="14"
                                               Margin="0,0,7,0" />
                                    <TextBlock Text="添加壁纸" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Width="38" Padding="0"
                                    Click="ImportFolderButton_Click" ToolTip="导入文件夹">
                                <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyphStyle}" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Settings header -->
                    <Grid Grid.Row="0" Margin="30,24,30,18"
                          Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="设置" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="调整播放、缩放和系统行为。" FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ShowLibraryCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" Style="{StaticResource IconGlyphStyle}" FontSize="13"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="返回壁纸库" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Restricted-environment warning -->
                    <Border Grid.Row="1" Margin="30,0,30,12" Padding="13,10" CornerRadius="10"
                            Background="#1AFB7185" BorderBrush="#59FB7185" BorderThickness="1"
                            Visibility="{Binding HasRuntimeWarning, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyphStyle}" FontSize="15"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,1,10,0"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeWarning}" FontSize="11.5"
                                       Foreground="#FFD8DE" TextWrapping="Wrap" LineHeight="18" />
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                    Margin="8,0,0,0" Command="{Binding DismissRuntimeWarningCommand}"
                                    ToolTip="关闭提示">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyphStyle}" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Library page -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="30,0,22,0"
                                  Visibility="{Binding IsSettingsVisible, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Margin="0,0,0,30">
                            <!-- Hero -->
                            <Border Height="238" CornerRadius="20" ClipToBounds="True"
                                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                <Grid>
                                    <Border Background="{StaticResource PlaceholderGradient}" />
                                    <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Margin="0,0,-90,0" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop Color="#3322D3EE" Offset="0" />
                                                <GradientStop Color="#1A8B5CF6" Offset="0.45" />
                                                <GradientStop Color="#00070B12" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Image Source="{Binding CurrentWallpaper.Thumbnail}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border Background="{StaticResource HeroShadeGradient}" />
                                    <Border Background="#1A0A1322" />

                                    <!-- Current wallpaper info -->
                                    <Grid Margin="26,22,26,22"
                                          Visibility="{Binding HasCurrentWallpaper, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#3322D3EE" BorderBrush="#5522D3EE" BorderThickness="1"
                                                    CornerRadius="7" Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding HeroBadgeText}" FontSize="9" FontFamily="Consolas"
                                                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#66080D18" CornerRadius="7" Padding="9,4" Margin="7,0,0,0">
                                                <TextBlock Text="{Binding CurrentWallpaper.KindLabel}" FontSize="10"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#66080D18" CornerRadius="7" Padding="9,4" Margin="7,0,0,0"
                                                    Visibility="{Binding IsVideoFailed, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="需要处理" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Bottom" MaxWidth="640">
                                                <TextBlock Text="{Binding HeroStatusText}" FontSize="11.5"
                                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentWallpaper.Title}" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="30" FontWeight="Bold" Foreground="White"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding HeroStatusDetail}" FontSize="11.5"
                                                           Foreground="#B8C5D8" TextTrimming="CharacterEllipsis"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                        Margin="16,0,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Height="36"
                                                        Command="{Binding TogglePauseCommand}"
                                                        Visibility="{Binding CanControlVideo, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PauseButtonGlyph}" Style="{StaticResource IconGlyphStyle}"
                                                                   FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PauseButtonLabel}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="8,0,0,0"
                                                        Command="{Binding NextCommand}" IsEnabled="{Binding HasWallpapers}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE893;" Style="{StaticResource IconGlyphStyle}"
                                                                   FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="下一张" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButtonStyle}" Height="36" Margin="4,0,0,0"
                                                        Command="{Binding StopCommand}" ToolTip="停止壁纸并恢复系统壁纸">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE71A;" Style="{StaticResource IconGlyphStyle}"
                                                                   FontSize="13" Margin="0,0,6,0" />
                                                        <TextBlock Text="停止" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- Empty hero -->
                                    <Grid Background="#E60A101B"
                                          Visibility="{Binding HasCurrentWallpaper, Converter={StaticResource InverseBoolToVisibility}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="54" Height="54" CornerRadius="18"
                                                    Background="#1A22D3EE" BorderBrush="#4A22D3EE" BorderThickness="1"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyphStyle}"
                                                           FontSize="24" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="让你的桌面动起来" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="22" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                                            <TextBlock Text="添加一张图片或一段视频，立即设为 Windows 桌面壁纸。"
                                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Height="34"
                                                        Click="AddImagesButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource IconGlyphStyle}"
                                                                   FontSize="13" Margin="0,0,6,0" />
                                                        <TextBlock Text="添加图片" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="8,0,0,0"
                                                        Click="AddVideosButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE714;" Style="{StaticResource IconGlyphStyle}"
                                                                   FontSize="13" Margin="0,0,6,0" />
                                                        <TextBlock Text="添加视频" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Library toolbar -->
                            <Grid Margin="2,24,2,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedFilterOption.Label}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding ResultSummary}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ImageFitSummary}" FontSize="10.5"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding VideoFitSummary}" FontSize="10.5"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Empty states -->
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeSoftBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="28" Margin="0,0,0,16"
                                    Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyphStyle}" FontSize="24"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="没有找到匹配的壁纸" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="试试换一个关键词，或切换到其他分类。"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Cards -->
                            <ItemsControl ItemsSource="{Binding WallpapersView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardBorder" Width="230" Height="214" Margin="0,0,12,14"
                                                CornerRadius="14" BorderThickness="1" ClipToBounds="True"
                                                Cursor="Hand"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                MouseLeftButtonUp="WallpaperCard_MouseLeftButtonUp"
                                                ToolTip="{Binding FileName}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#3C5673" />
                                                            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                            <Setter Property="Opacity" Value="0.62" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                             Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="应用壁纸"
                                                              Command="{Binding Tag.ApplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="在资源管理器中显示"
                                                              Command="{Binding Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="从壁纸库移除"
                                                              Command="{Binding Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="142" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" ClipToBounds="True">
                                                    <Grid>
                                                        <Border Background="{Binding PlaceholderBrush}" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Border Height="56" VerticalAlignment="Bottom">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00070B12" Offset="0" />
                                                                    <GradientStop Color="#AA070B12" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <Border Background="#B3070B12" CornerRadius="6" Padding="7,3"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xEB9F;" Style="{StaticResource IconGlyphStyle}"
                                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,0,4,0"
                                                                           Visibility="{Binding IsVideo, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                <TextBlock Text="&#xE714;" Style="{StaticResource IconGlyphStyle}"
                                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,0,4,0"
                                                                           Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Text="{Binding KindLabel}" FontSize="9.5"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#E622D3EE" CornerRadius="6" Padding="7,3"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="使用中" FontSize="9" FontWeight="SemiBold" Foreground="#06111B" />
                                                        </Border>

                                                        <Border Width="42" Height="42" CornerRadius="21" Background="#66050A12"
                                                                BorderBrush="#66FFFFFF" BorderThickness="1"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyphStyle}"
                                                                       FontSize="16" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Margin="2,0,0,0" />
                                                        </Border>

                                                        <Border Background="#D9080D16" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyphStyle}"
                                                                           FontSize="20" Foreground="{StaticResource DangerBrush}"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Text="文件已丢失" FontSize="11"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Row="1" Margin="13,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding MetaText}" FontSize="9.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                            Width="30" Height="30" ToolTip="应用壁纸"
                                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding IsMissing, Converter={StaticResource InverseBool}}">
                                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyphStyle}"
                                                                   FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings page -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch" Padding="30,0,22,0"
                                  Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="0,0,0,34" MaxWidth="960" HorizontalAlignment="Stretch">
                            <!-- Playback -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A22D3EE">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyphStyle}" FontSize="16"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="播放与轮播" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="决定壁纸如何播放与自动切换。" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingRowStyle}" Margin="0,15,0,0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="自动轮播" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="按固定间隔切换壁纸库中的图片和视频。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoRotate, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="轮播间隔" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="自动轮播开启后生效。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox Style="{StaticResource ComboBoxStyle}" Width="142"
                                                      ItemTemplate="{StaticResource RotationOptionTemplate}"
                                                      ItemsSource="{Binding RotationIntervalOptions}"
                                                      SelectedValuePath="Minutes"
                                                      SelectedValue="{Binding RotationIntervalMinutes, Mode=TwoWay}"
                                                      IsEnabled="{Binding AutoRotate}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="随机顺序" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="轮播时随机挑选，而不是按壁纸库顺序。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Shuffle, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Video -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A8B5CF6">
                                            <TextBlock Text="&#xE714;" Style="{StaticResource IconGlyphStyle}" FontSize="16"
                                                       Foreground="#C4B5FD"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="视频壁纸" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="视频通过 Windows 桌面层渲染，并自动适配显示器变化。" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingRowStyle}" Margin="0,15,0,0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="静音播放" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="默认关闭视频声音，避免打扰。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MuteVideo, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="全屏应用时暂停" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="检测到全屏游戏或演示时暂停播放，离开后自动恢复。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding PauseOnFullscreen, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="视频缩放方式" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="填充会裁切边缘，适应会保留完整画面。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox Style="{StaticResource ComboBoxStyle}" Width="126"
                                                      ItemTemplate="{StaticResource FitOptionTemplate}"
                                                      ItemsSource="{Binding VideoFitOptions}"
                                                      SelectedValuePath="Fit"
                                                      SelectedValue="{Binding VideoFit, Mode=TwoWay}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Image -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A34D399">
                                            <TextBlock Text="&#xEB9F;" Style="{StaticResource IconGlyphStyle}" FontSize="16"
                                                       Foreground="#6EE7B7"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="图片壁纸" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="图片由 Windows 原生壁纸接口立即应用。" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Style="{StaticResource SettingRowStyle}" Margin="0,15,0,0" BorderThickness="0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="图片缩放方式" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="支持填充、适应、拉伸、居中和平铺。修改后会立即刷新当前图片。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox Style="{StaticResource ComboBoxStyle}" Width="126"
                                                      ItemTemplate="{StaticResource FitOptionTemplate}"
                                                      ItemsSource="{Binding ImageFitOptions}"
                                                      SelectedValuePath="Fit"
                                                      SelectedValue="{Binding ImageFit, Mode=TwoWay}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- System -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#1AFBBF24">
                                            <TextBlock Text="&#xE770;" Style="{StaticResource IconGlyphStyle}" FontSize="16"
                                                       Foreground="#FCD34D"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="系统与启动" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="控制应用与 Windows 的协作方式。" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingRowStyle}" Margin="0,15,0,0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="开机自动启动" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="登录 Windows 后自动在托盘中恢复上次的壁纸。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="关闭主窗口不会退出，壁纸会继续运行。" Style="{StaticResource SettingDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="数据目录" Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SettingDescriptionStyle}"
                                                           FontFamily="Consolas" FontSize="10.5" />
                                            </StackPanel>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="打开"
                                                    Command="{Binding OpenDataFolderCommand}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="维护" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="恢复系统原来的壁纸，或清空本机的壁纸库记录。" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="恢复系统壁纸"
                                                Command="{Binding StopCommand}" IsEnabled="{Binding HasCurrentWallpaper}" />
                                        <Button Style="{StaticResource DangerButtonStyle}" Content="清空壁纸库"
                                                Margin="10,0,0,0" Click="ClearLibraryButton_Click" />
                                    </StackPanel>
                                    <TextBlock Text="说明：动态壁纸使用 LibVLC 渲染到 Windows 桌面层。资源管理器重启后，应用会自动重新挂载视频。"
                                               FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="WowWallPaper · 原生 Windows 壁纸引擎 · 视频播放依赖系统 Media Foundation"
                                       FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="2,2,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Drop overlay -->
            <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#DD070C15"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="8" CornerRadius="16"
                    Panel.ZIndex="30" IsHitTestVisible="False">
                <Grid>
                    <Rectangle RadiusX="12" RadiusY="12" Stroke="#8822D3EE" StrokeThickness="1" StrokeDashArray="5 4"
                               Margin="18" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="58" Height="58" CornerRadius="18" Background="#1F22D3EE"
                                BorderBrush="#6622D3EE" BorderThickness="1" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyphStyle}" FontSize="26"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="松开以添加壁纸" FontFamily="{StaticResource DisplayFont}" FontSize="23"
                                   FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="支持图片和视频文件" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Busy overlay -->
            <Grid Grid.RowSpan="2" Background="#62050A10" Panel.ZIndex="40"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="18,14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="22" Margin="0,0,12,0">
                            <Ellipse Stroke="#2C3B52" StrokeThickness="2" Width="18" Height="18" />
                            <Path Data="M 11,2 A 9,9 0 0 1 20,11" Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock Text="{Binding BusyText}" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Toast -->
            <Border x:Name="ToastBorder" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0"
                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,26,24"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="500"
                    Panel.ZIndex="50" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="&#xE946;" Style="{StaticResource IconGlyphStyle}" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="ToastMessage" FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
